<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HPShare.csproj" />
    <Reference Include="sts2" HintPath="$(GameDir)\sts2.dll" Private="true" />
    <Reference Include="0Harmony" HintPath="$(GameDir)\0Harmony.dll" Private="true" />
    <Reference Include="GodotSharp" HintPath="$(GameDir)\GodotSharp.dll" Private="true" />
  </ItemGroup>
</Project>
